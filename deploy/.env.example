# ============================================================================
# EduMatrix 部署级参数 —— 字段清单模板
#
# 用法：复制为 backend/.env（已在 .gitignore 中）并填入真实值。
#   05-工程结构.md §F4 定案：本地开发只走 backend/.env 这一种方式，
#   不要同时用本地 profile 覆盖 —— 两条路并存时排查成本远大于收益。
#
# 【这里放什么，不放什么】
#   放：不同机构用同一个值的参数（云账号、队列、数据库、调度中心）。
#   不放：租户配置键 —— complete_rate_threshold / watermark_phone_mask
#         这两个（且只有这两个，契约 §5 白名单）在 sys_tenant_config 表里，
#         永远不进配置文件。
#   分辨方法：问「不同机构会不会要不同的值」。
#
# 【消费方】§G2：ALIYUN_* / VOD_* 的全部消费方是 integration/aliyun 下的四个 Client。
#   任何业务包里出现 @Value("${ALIYUN_...}") 都是越界。
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库（模块 01 起使用）
#
# 【库名必须是 edumatrix，且与 spring.flyway.schemas 不得分叉】
#   Flyway 初始基线 V202608120000__baseline.sql 内含 CREATE DATABASE IF NOT EXISTS
#   `edumatrix` 与 USE `edumatrix`（基线内容一字未改，契约 §7.3）。
#
#   实测（数据源指向 edumatrix_wrong、flyway.schemas=edumatrix）：
#     · 41 张业务表全部落在 edumatrix
#     · flyway_schema_history 也落在 edumatrix
#     · migrate() 【成功完成，无任何报错】
#     · edumatrix_wrong 是空库
#   也就是说：迁移全落到 edumatrix，而应用连接池此后连的是 URL 指定的那个空库。
#   Flyway 报成功、应用启动成功、所有业务查询打在空库上 —— 不报错的故障。
#
# 【createDatabaseIfNotExist=true 仅限本地开发，生产必须去掉】
#   开发时它让首次启动能在空 MySQL 上自建库；生产环境下它的含义变成
#   「库名打错时静默建一个空库并启动成功」，而不是启动失败。之后 Flyway 会在
#   那个空库上跑完全部迁移，服务正常起来，只是所有数据都不见了。
#   生产要的恰恰是【连不上就启动失败】。
#
# 【不要加 allowMultiQueries=true】
#   曾以为基线脚本自带 CREATE DATABASE / USE 必须整段送给 MySQL 才行 —— 实测不成立：
#   Flyway 自己解析并逐条执行迁移脚本，不依赖 JDBC 的多语句开关。
#   空库 + 无该参数实测：41 张表、7 个分区、3 个脚本全 success。
#   而它是【整个连接池全程生效】的开关：业务代码任何一处 SQL 拼接注入点，
#   都会从"能读一行"升级成"能追加 ; DROP TABLE ..."。
#   本项目在租户隔离上做了这么多，不该在 JDBC 层敞一个全局的口子。
# ---------------------------------------------------------------------------
MYSQL_URL=jdbc:mysql://127.0.0.1:13306/edumatrix?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
MYSQL_USER=edumatrix
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Redis（模块 01 起使用：node:anc:{nodeId} 祖先链缓存、idem:{userId}:{requestId} 幂等键）
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------------------------------------------------------------------
# 雪花 ID（模块 01 新增登记，见 05-工程结构.md §F4）
#
# 多实例部署时 worker-id 必须逐台不同 —— 两台机器同号会产生重复主键，
# 而重复主键在写入时才报错，且报的是唯一键冲突，不会指向配置。
# 取值范围各 0~31。
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_DATACENTER_ID=0

# ---------------------------------------------------------------------------
# XXL-Job（模块 05 补上执行器装配；模块 01 只交付了 traceId 继承包装）
#
# 【XXL_JOB_ENABLED 是「哪条路径触发定时任务」的开关，两条互斥】
#   false / 未配（当前）→ job/ScheduledJobTrigger 用 Spring 自带调度触发
#                        （过渡期。需方定案：暂不部署调度中心，见 F-41）
#   true                → common/config/XxlJobConfig 装配 XXL-Job 执行器，
#                        Spring 那条【自动消失】
#   互斥由互为镜像的 @ConditionalOnProperty 保证，并由
#   ScheduledJobTriggerConditionTest 实测钉住 —— 双触发【不会报错】，
#   任务只是每天跑两遍，而两个任务都幂等，真跑两遍也看不出来。
#
# 【⚠ 模块 05 之前这个开关没有任何东西在读】
#   XxlJobSpringExecutor 全库不存在，两个 @XxlJob 是惰性注解 ——
#   置 true 也不会有任何事发生。这是本项目「以为存在、实际从未生效」的第六例。
#
# 【翻到 true 之前必须先有调度中心】
#   置 true 而 XXL_JOB_ADMIN_ADDRESSES 为空 = Spring 那条消失、XXL-Job 又没人调度，
#   两个合规任务【谁都不会触发】，而应用一切正常。XxlJobConfig 为此打了一条 WARN。
#   两个任务的 cron 在 job/ScheduledJobTrigger 的两个常量上，
#   在调度中心登记时【照抄那两个值】，否则行为会在切换那一刻变：
#     anonymizeArchivedStudent  0 30 2 * * *   每日 02:30  30 日不可逆脱敏
#     tempFileCleanup           0 30 3 * * *   每日 03:30  敏感文件 7 天清理
# ---------------------------------------------------------------------------
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_EXECUTOR_PORT=9999

# ---------------------------------------------------------------------------
# 阿里云（模块 05 / 09 / 12 使用；消费方仅 integration/aliyun/**）
#
# 【两个独立的下拉框，选对一个不代表选对另一个】契约 §1 区域约束：
#   存储区域仅中国大陆；加速域名的加速区域仅中国内地。
#   新增任何区域前必须先完成「该区域的消息队列与事件通知配置」与
#   「个保法第 38 条出境合规评审」，两项未完成不得开启。
#
# 【凭据必须是 RAM 子账号，不得用主账号 AccessKey】
#   主账号 AK 等于全账号全服务的最高权限，泄露一次就是整个云账号。
#   本项目的 OSS 策略只授：
#     Put/Get/Delete Object + AbortMultipartUpload + ListParts + ListObjects + GetBucketInfo
#   【不授】PutBucketAcl / PutBucketPolicy / DeleteBucket ——
#   没有 PutBucketAcl 就意味着即使 AK 泄露，攻击者也【改不了桶的私有属性】。
#   （OssClient 的启动自检只调 GetBucketInfo 一个接口，正是为了配合这条最小权限：
#     BucketInfo 同时带 CannedACL、Location 与 IntranetEndpoint，
#     一次调用把「必须私有」「必须在中国大陆」「不得跨地域」三条都验到，
#     不需要额外的 oss:GetBucketAcl。）
# ---------------------------------------------------------------------------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VOD_REGION=
# 转码模板组：必须是单一清晰度 + Encrypt=true 的加密 HLS 输出（契约 §1）
ALIYUN_VOD_TEMPLATE_GROUP_ID=
# 轻量消息队列：Endpoint 必须是公网 Endpoint，否则点播服务写队列失败、重试 3 次后静默丢弃
ALIYUN_SMQ_ENDPOINT=
ALIYUN_SMQ_QUEUE_NAME=
ALIYUN_KMS_KEY_ID=
ALIYUN_KMS_REGION=

# --- OSS（模块 05）-----------------------------------------------------------
# 【留空 = 走本地磁盘】application.yml 的装配条件写在 ALIYUN_OSS_BUCKET 上：
#   非空 → integration/aliyun/OssClient（sys_file.storage 写 2）
#   为空 → common/file/LocalObjectStorage（写 1）
#   本地开发与集成测试留空即可 —— 测试环境没有 OSS。
#
# 【两个 endpoint 必须都填，且不是同一个】
#   INTERNAL 供服务端 Put/Get/Delete：同地域走内网，不计流量费、不出公网。
#   PUBLIC   只用来【签名】，不发请求 —— 签出来的地址是给浏览器用的。
#   填反了会响亮失败（客户端 DNS 解析不到 *-internal 域名），不是静默故障。
#   例（杭州）：oss-cn-hangzhou-internal.aliyuncs.com / oss-cn-hangzhou.aliyuncs.com
#
# 【地域必须与 ECS 同地域，且必须在中国大陆 —— 两条都在启动时被强制】
#   OssClient 调一次 GetBucketInfo，验三件事，任一不满足【直接启动失败】：
#     ① 桶 ACL 必须 Private（00-通用约定 §7.4）；
#     ② Location 必须 oss-cn-*（契约 §7.2 第 4 条「不得开启任何境外节点」——
#        在此之前这句话全库零承载）；
#     ③ ALIYUN_OSS_INTERNAL_ENDPOINT 必须【等于】桶自报的内网 endpoint。
#
#   【③ 为什么不能靠"名字里有 oss-cn-"来判】oss-cn-beijing 也以 oss-cn- 开头，
#   桶在北京、ECS 在杭州完全能通过 ②。后果是走公网：计流量费、延迟高，
#   而且【完全静默】，账单要到月底才看得出来。
#   而只要真用内网 endpoint，跨地域会响亮失败（杭州 ECS 连不上
#   oss-cn-beijing-internal）—— 问题是那种失败发生在第一次上传时，
#   且运维为了"先跑起来"最常见的处置恰恰是把公网 endpoint 填进内网这一格，
#   一改就从"响亮失败"变回"静默花钱"。
#   所以不判名字、直接与桶自报的值比对，两种形态一起盖住，且在【启动时】暴露。
#
#   ALIYUN_OSS_PUBLIC_ENDPOINT 与桶默认外网 endpoint 不同时【只 WARN 不拒绝】——
#   将来绑自有加速域名（file.hqtw.cn，需备案）时它本来就会不同。
#
# 【文件域名与业务域名分离（00-通用约定 §7.4）已由默认 endpoint 满足】
#   {bucket}.oss-cn-*.aliyuncs.com 与 hqtw.cn 是不同域名。
#   用默认 endpoint【不需要备案】；绑自定义域名（如 file.hqtw.cn）才需要，
#   而 hqtw.cn 的备案接入变更至今未做（见 deploy/prod/Caddyfile 头注释）。
#   将来要换成自有子域，只改 ALIYUN_OSS_PUBLIC_ENDPOINT 一个值，代码不动。
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_INTERNAL_ENDPOINT=
ALIYUN_OSS_PUBLIC_ENDPOINT=

# 加速域名与 URL 鉴权密钥。加速域名必须完成 ICP 备案（周级前置项）
VOD_CDN_DOMAIN=
VOD_CDN_AUTH_KEY=

# ---------------------------------------------------------------------------
# 服务本身
# ---------------------------------------------------------------------------
SERVER_PORT=8080
