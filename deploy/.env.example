# ============================================================================
# EduMatrix 部署级参数 —— 字段清单模板
#
# 用法：复制为 backend/.env（已在 .gitignore 中）并填入真实值。
#   05-工程结构.md §F4 定案：本地开发只走 backend/.env 这一种方式，
#   不要同时用本地 profile 覆盖 —— 两条路并存时排查成本远大于收益。
#
# 【这里放什么，不放什么】
#   放：不同机构用同一个值的参数（云账号、队列、数据库、调度中心）。
#   不放：租户配置键 —— complete_rate_threshold / watermark_phone_mask
#         这两个（且只有这两个，契约 §5 白名单）在 sys_tenant_config 表里，
#         永远不进配置文件。
#   分辨方法：问「不同机构会不会要不同的值」。
#
# 【消费方】§G2：ALIYUN_* / VOD_* 的全部消费方是 integration/aliyun 下的四个 Client。
#   任何业务包里出现 @Value("${ALIYUN_...}") 都是越界。
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库（模块 01 起使用）
#
# 【库名必须是 edumatrix，且与 spring.flyway.schemas 不得分叉】
#   Flyway 初始基线 V202608120000__baseline.sql 内含 CREATE DATABASE IF NOT EXISTS
#   `edumatrix` 与 USE `edumatrix`（基线内容一字未改，契约 §7.3）。
#
#   实测（数据源指向 edumatrix_wrong、flyway.schemas=edumatrix）：
#     · 41 张业务表全部落在 edumatrix
#     · flyway_schema_history 也落在 edumatrix
#     · migrate() 【成功完成，无任何报错】
#     · edumatrix_wrong 是空库
#   也就是说：迁移全落到 edumatrix，而应用连接池此后连的是 URL 指定的那个空库。
#   Flyway 报成功、应用启动成功、所有业务查询打在空库上 —— 不报错的故障。
#
# 【createDatabaseIfNotExist=true 仅限本地开发，生产必须去掉】
#   开发时它让首次启动能在空 MySQL 上自建库；生产环境下它的含义变成
#   「库名打错时静默建一个空库并启动成功」，而不是启动失败。之后 Flyway 会在
#   那个空库上跑完全部迁移，服务正常起来，只是所有数据都不见了。
#   生产要的恰恰是【连不上就启动失败】。
#
# 【不要加 allowMultiQueries=true】
#   曾以为基线脚本自带 CREATE DATABASE / USE 必须整段送给 MySQL 才行 —— 实测不成立：
#   Flyway 自己解析并逐条执行迁移脚本，不依赖 JDBC 的多语句开关。
#   空库 + 无该参数实测：41 张表、7 个分区、3 个脚本全 success。
#   而它是【整个连接池全程生效】的开关：业务代码任何一处 SQL 拼接注入点，
#   都会从"能读一行"升级成"能追加 ; DROP TABLE ..."。
#   本项目在租户隔离上做了这么多，不该在 JDBC 层敞一个全局的口子。
# ---------------------------------------------------------------------------
MYSQL_URL=jdbc:mysql://127.0.0.1:13306/edumatrix?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
MYSQL_USER=edumatrix
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Redis（模块 01 起使用：node:anc:{nodeId} 祖先链缓存、idem:{userId}:{requestId} 幂等键）
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------------------------------------------------------------------
# 雪花 ID（模块 01 新增登记，见 05-工程结构.md §F4）
#
# 多实例部署时 worker-id 必须逐台不同 —— 两台机器同号会产生重复主键，
# 而重复主键在写入时才报错，且报的是唯一键冲突，不会指向配置。
# 取值范围各 0~31。
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_DATACENTER_ID=0

# ---------------------------------------------------------------------------
# XXL-Job 调度中心（模块 05 起真正使用；模块 01 只交付 traceId 继承包装）
# 本地默认不启用执行器，避免没有调度中心时启动失败。
# ---------------------------------------------------------------------------
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_EXECUTOR_PORT=9999

# ---------------------------------------------------------------------------
# 阿里云（模块 05 / 09 / 12 使用；消费方仅 integration/aliyun/**）
#
# 【两个独立的下拉框，选对一个不代表选对另一个】契约 §1 区域约束：
#   存储区域仅中国大陆；加速域名的加速区域仅中国内地。
#   新增任何区域前必须先完成「该区域的消息队列与事件通知配置」与
#   「个保法第 38 条出境合规评审」，两项未完成不得开启。
# ---------------------------------------------------------------------------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VOD_REGION=
# 转码模板组：必须是单一清晰度 + Encrypt=true 的加密 HLS 输出（契约 §1）
ALIYUN_VOD_TEMPLATE_GROUP_ID=
# 轻量消息队列：Endpoint 必须是公网 Endpoint，否则点播服务写队列失败、重试 3 次后静默丢弃
ALIYUN_SMQ_ENDPOINT=
ALIYUN_SMQ_QUEUE_NAME=
ALIYUN_KMS_KEY_ID=
ALIYUN_KMS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=

# 加速域名与 URL 鉴权密钥。加速域名必须完成 ICP 备案（周级前置项）
VOD_CDN_DOMAIN=
VOD_CDN_AUTH_KEY=

# ---------------------------------------------------------------------------
# 服务本身
# ---------------------------------------------------------------------------
SERVER_PORT=8080
