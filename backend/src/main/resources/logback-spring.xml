<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  【traceId 必须出现在每一行】契约 §7.1：traceId 经 MDC 贯穿日志、异步线程池、XXL-Job 与 MQ，
  响应头 X-Trace-Id 原样回传 —— 用户截图报错时，那个 32 位 hex 就是唯一的检索键。
  日志行里没有它，回传就白做了。

  parentTraceId 只在异步任务继承不到 traceId、新生成一条链路时才有值（契约 §7.1），
  所以用 %X{parentTraceId:-} 让它在缺省时留空而不是打印 "parentTraceId_IS_UNDEFINED"。
-->
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="edumatrix"/>

    <!--
      日志目录。默认 logs（相对工作目录），保持本地开发与既有行为不变；
      生产用环境变量 LOG_PATH 指到 /var/log/edumatrix。

      【为什么要可配】systemd 单元用 ProtectSystem=strict 把文件系统挂成只读，
      只有 ReadWritePaths 列出的目录可写。写死相对路径时应用启动即抛
      FileNotFoundException: logs/edumatrix-backend.log (No such file or directory) ——
      而更麻烦的是「把 /opt/edumatrix 也开成可写」这条路：应用日志会落在
      /opt/edumatrix/logs/，而 logrotate 配置管的是 /var/log/edumatrix/，
      于是【真正会长大的那个文件没人轮转】——这台 2 核 4G 机器上它是唯一会失控增长的东西。
    -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}%X{parentTraceId:- }] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <!--
              保留 180 天。契约 §7.2 第 5 条要求 sys_login_log / sys_oper_log 保留 ≥ 6 个月
              （《网络安全法》第 21 条）。那两张是数据库表、由归档任务管，与本文件无关，
              但应用日志跟着同一个保留期，排查合规问题时两边才对得上。
            -->
            <maxHistory>180</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
